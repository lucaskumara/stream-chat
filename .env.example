# Copy to .env.local and fill in. .env.local is gitignored; this file is not, so it
# must never carry real values.
#
# Kick: kick.com/settings/developer (needs 2FA on the account first).
# The redirect URL registered there must be exactly http://localhost:4569/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# YouTube: a Google Cloud OAuth client of type "Desktop app", with the YouTube Data
# API v3 enabled. The secret is optional — Google states installed apps cannot keep
# secrets, and PKCE is what protects the exchange.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Twitch needs nothing here: its client id is a build constant and the device code
# grant is a public-client flow.
